# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API Keys (see docs/supabase-setup.md).
# The anon key or the newer "publishable" key (sb_publishable_...) both work here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key (never expose to the browser). Needed later for admin tasks.
SUPABASE_SERVICE_ROLE_KEY=
